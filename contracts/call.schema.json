{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-roleplay/call.schema.json",
  "title": "Character video call",
  "description": "A calling character and its chat topics (content/calls/<character>.json). English fields feed the LLM/TTS; *_ko fields are UI text. Every scenario is also offered as a role call by the same character.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name_en", "name_ko", "default_voice_id", "voice_pitch", "persona_en", "turns", "openings", "topics"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name_en": { "$ref": "#/$defs/text" },
    "name_ko": { "$ref": "#/$defs/text" },
    "default_voice_id": { "$ref": "#/$defs/id" },
    "voice_pitch": {
      "description": "The web client raises the voice by this factor without changing its tempo (1 = as synthesized).",
      "type": "number",
      "minimum": 1,
      "maximum": 1.6
    },
    "persona_en": { "$ref": "#/$defs/text" },
    "turns": {
      "description": "Learner turns per call. The second-to-last reply starts the goodbye, the last one ends the call.",
      "type": "object",
      "additionalProperties": false,
      "required": ["easy", "normal", "hard"],
      "properties": { "easy": { "$ref": "#/$defs/turns" }, "normal": { "$ref": "#/$defs/turns" }, "hard": { "$ref": "#/$defs/turns" } }
    },
    "openings": {
      "description": "The character's first line by local time of day.",
      "type": "object",
      "additionalProperties": false,
      "required": ["morning", "day", "evening"],
      "properties": { "morning": { "$ref": "#/$defs/sentence" }, "day": { "$ref": "#/$defs/sentence" }, "evening": { "$ref": "#/$defs/sentence" } }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["call_id", "title_ko", "title_en", "teaser_ko", "first_question_en"],
        "properties": {
          "call_id": { "type": "string", "pattern": "^call_[a-z0-9_]+$" },
          "title_ko": { "$ref": "#/$defs/text" },
          "title_en": { "$ref": "#/$defs/text" },
          "teaser_ko": { "$ref": "#/$defs/text" },
          "first_question_en": { "type": "string", "pattern": "\\?$" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "text": { "type": "string", "minLength": 1 },
    "turns": { "type": "integer", "minimum": 3, "maximum": 8 },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_id", "en", "ko"],
      "properties": {
        "text_id": { "$ref": "#/$defs/id" },
        "en": { "type": "string", "minLength": 1, "maxLength": 400 },
        "ko": { "$ref": "#/$defs/text" }
      }
    }
  }
}
